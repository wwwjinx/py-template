APP_PORT=8001
APP_NAME=py-template
LOG_LEVEL=WARNING
# LOG_DIR=logs
# LOG_MODULE_CACHE_SIZE=256
CORS_ENABLED=false
CORS_ORIGINS=
# DATABASE_URL=postgresql+psycopg_async://user:pass@localhost:5432/dbname
DATABASE_URL=
# Redis — placeholders only
# REDIS_URL=redis://:your_password@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USERNAME=
# JWT（HS256）。只写占位，不要把真实密钥提交进仓库。
# JWT_SECRET=change-me
# JWT_EXPIRE_MINUTES=1440
# JWT_ALGORITHM=HS256

# 文件存储（默认本地磁盘 uploads/，访问路径 /uploads）
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=uploads
# STORAGE_PUBLIC_BASE_URL=
# STORAGE_URL_PREFIX=/uploads
# STORAGE_MAX_SIZE_MB=10
# STORAGE_ALLOWED_EXTS=jpg,jpeg,png,gif,webp,bmp,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip
